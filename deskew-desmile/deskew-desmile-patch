 import streamlit as st
 import numpy as np
 from PIL import Image
+
+# ==== [PATCH] OpenCV safeguard & pre-calibration helpers ======================
+try:
+    import cv2  # OpenCV is optional; UI will degrade gracefully if missing
+    _HAS_CV2 = True
+except Exception:
+    cv2 = None
+    _HAS_CV2 = False
+
+def _apply_geom_precal(img_pil: Image.Image, rotate_deg: float = 0.0,
+                       shear_deg: float = 0.0, desmile_px: float = 0.0) -> Image.Image:
+    """
+    Rotate, shear (deskew), and 'desmile' (quadratic vertical remap) a gel image.
+    - rotate_deg: small fine rotation in degrees.
+    - shear_deg: horizontal shear in degrees to correct lane lean.
+    - desmile_px: vertical correction @ edges in pixels; counters curved band 'smile'.
+    """
+    if not _HAS_CV2:
+        return img_pil  # graceful no-op if OpenCV unavailable
+    img = np.asarray(img_pil)
+    h, w = img.shape[:2]
+    out = img
+    # 1) Rotate around center
+    if abs(rotate_deg) > 1e-3:
+        M = cv2.getRotationMatrix2D((w/2, h/2), rotate_deg, 1.0)
+        out = cv2.warpAffine(out, M, (w, h), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)
+    # 2) Horizontal shear (deskew)
+    if abs(shear_deg) > 1e-3:
+        sh = np.tan(np.deg2rad(shear_deg))
+        M = np.array([[1, sh, 0], [0, 1, 0]], dtype=np.float32)
+        out = cv2.warpAffine(out, M, (w + int(abs(h*sh)), h), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)
+        out = out[:, :w]  # crop back to original width
+    # 3) Desmile: quadratic vertical offset across columns
+    if abs(desmile_px) > 1e-3:
+        yy, xx = np.indices((h, w), dtype=np.float32)
+        x = (xx - w/2) / (w/2)
+        offset = desmile_px * (x**2 - 1.0)  # 0 at center, -desmile_px at edges
+        map_y = (yy + offset).clip(0, h-1)
+        out = cv2.remap(out, xx, map_y, interpolation=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)
+    return Image.fromarray(out)
+# =============================================================================
 
