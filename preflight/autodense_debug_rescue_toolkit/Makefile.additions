# --- Smart preflight + rescue wrappers (non-destructive) ---
WORKDIR ?= audits/autotune_runs
JAVA_MAIN    ?= com.betterdairy.autodense.cli.AutotuneAnalysisCLI
POM_DIR_PATH ?= autodense/plugin

smart-sds:
	python scripts/with_preflight_and_rescue.py 	  --task sds_page 	  --input "$(INPUT)" 	  --outdir "$(WORKDIR)/sds_page/$(shell basename "$(INPUT)" | sed 's/\.[^.]*$$//')/smart" 	  --base-config configs/sds.yaml 	  --java-main $(JAVA_MAIN) --pom-dir $(POM_DIR_PATH)

smart-etbr:
	python scripts/with_preflight_and_rescue.py 	  --task etbr_agarose 	  --input "$(INPUT)" 	  --outdir "$(WORKDIR)/etbr_agarose/$(shell basename "$(INPUT)" | sed 's/\.[^.]*$$//')/smart" 	  --base-config configs/etbr.yaml 	  --java-main $(JAVA_MAIN) --pom-dir $(POM_DIR_PATH)

smart-colony:
	python scripts/with_preflight_and_rescue.py 	  --task colony_count 	  --input "$(INPUT)" 	  --outdir "$(WORKDIR)/colony_count/$(shell basename "$(INPUT)" | sed 's/\.[^.]*$$//')/smart" 	  --base-config configs/colony.yaml 	  --java-main $(JAVA_MAIN) --pom-dir $(POM_DIR_PATH)

# Debug helpers
profile-plot:
	python scripts/plot_profiles.py --input "$(INPUT)" --out "$(OUT)"
verify-report:
	python scripts/verify_report.py "$(FILE)"
