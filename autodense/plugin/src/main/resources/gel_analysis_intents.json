{
  "intents": {
    "lane_detection": {
      "patterns": [
        "detect lanes", "find lanes", "identify lanes", "locate lanes",
        "X lanes", "has X lanes", "contains X lanes", "X lane gel",
        "count lanes", "how many lanes", "please find", "find them all",
        "gel has", "find the", "lanes so please", "12 lanes"
      ],
      "parameters": {
        "lane_count": {
          "patterns": ["\\d+", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"],
          "mapping": {"one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6, "seven": 7, "eight": 8, "nine": 9, "ten": 10, "eleven": 11, "twelve": 12}
        }
      },
      "action": "executeLaneDetection"
    },
    
    "lane_adjustment": {
      "patterns": [
        "offset lanes", "shift lanes", "adjust lanes", "move lanes",
        "lanes are off", "lanes not centered", "lane positioning"
      ],
      "parameters": {
        "direction": {
          "patterns": ["left", "right", "up", "down"],
          "default": "left"
        },
        "amount": {
          "patterns": ["\\d*\\.?\\d+", "slightly", "a bit", "more", "less"],
          "mapping": {"slightly": 0.02, "a bit": 0.03, "more": 0.1, "less": 0.01}
        }
      },
      "action": "executeLaneAdjustment"
    },

    "band_detection": {
      "patterns": [
        "detect bands", "find bands", "identify bands", "locate bands",
        "band detection", "protein bands", "DNA bands"
      ],
      "parameters": {
        "lane_range": {
          "patterns": ["lane \\d+", "lanes \\d+-\\d+", "all lanes", "selected lanes"]
        },
        "sensitivity": {
          "patterns": ["high sensitivity", "low sensitivity", "sensitive", "less sensitive"],
          "mapping": {"high": 0.8, "low": 0.3, "sensitive": 0.7, "less sensitive": 0.4}
        }
      },
      "action": "executeBandDetection"
    },

    "quantification": {
      "patterns": [
        "quantify", "quantification", "measure bands", "band intensity",
        "densitometry", "optical density", "OD", "intensity values"
      ],
      "parameters": {
        "background_method": {
          "patterns": ["rolling ball", "median", "mean", "local background"],
          "default": "median"
        },
        "normalization": {
          "patterns": ["total lane", "loading control", "reference band", "no normalization"],
          "default": "total lane"
        }
      },
      "action": "executeQuantification"
    },

    "image_enhancement": {
      "patterns": [
        "brighten", "darken", "increase contrast", "decrease contrast",
        "enhance", "adjust brightness", "adjust contrast", "gamma correction",
        "too dark", "too bright", "low contrast", "high contrast"
      ],
      "parameters": {
        "brightness": {
          "patterns": ["brighter", "darker", "\\+\\d+", "\\-\\d+"],
          "mapping": {"brighter": 1.2, "darker": 0.8}
        },
        "contrast": {
          "patterns": ["more contrast", "less contrast", "high contrast", "low contrast"],
          "mapping": {"more": 1.3, "less": 0.7, "high": 1.5, "low": 0.5}
        }
      },
      "action": "executeImageEnhancement"
    },

    "calibration": {
      "patterns": [
        "calibrate", "molecular weight", "MW ladder", "protein ladder", "DNA ladder",
        "standard", "marker", "size standard", "weight standard"
      ],
      "parameters": {
        "ladder_type": {
          "patterns": ["protein", "DNA", "RNA", "NEB", "Bio-Rad", "Thermo", "Invitrogen"],
          "default": "protein"
        },
        "ladder_lane": {
          "patterns": ["lane \\d+", "first lane", "last lane", "left", "right"],
          "mapping": {"first": 1, "last": -1, "left": 1, "right": -1}
        }
      },
      "action": "executeCalibration"
    },

    "export_results": {
      "patterns": [
        "export", "save results", "download", "CSV", "Excel", "PDF",
        "generate report", "save data", "output results"
      ],
      "parameters": {
        "format": {
          "patterns": ["CSV", "Excel", "PDF", "PNG", "TIFF", "JSON"],
          "default": "CSV"
        },
        "include": {
          "patterns": ["raw data", "processed data", "images", "statistics", "all"],
          "default": "all"
        }
      },
      "action": "executeExport"
    },

    "gel_type_detection": {
      "patterns": [
        "SDS-PAGE", "PAGE", "agarose", "DNA gel", "protein gel", "native gel",
        "gradient gel", "urea gel", "bis-tris", "tricine"
      ],
      "parameters": {
        "gel_type": {
          "patterns": ["SDS", "PAGE", "agarose", "DNA", "protein", "native", "gradient", "urea"],
          "default": "SDS-PAGE"
        }
      },
      "action": "setGelType"
    },

    "workflow_automation": {
      "patterns": [
        "analyze gel", "complete analysis", "full analysis", "standard workflow",
        "quick analysis", "auto analyze", "process gel"
      ],
      "parameters": {
        "workflow_type": {
          "patterns": ["quick", "standard", "comprehensive", "custom"],
          "default": "standard"
        }
      },
      "action": "executeWorkflow"
    },

    "help_guidance": {
      "patterns": [
        "help", "how to", "what can you do", "available commands",
        "getting started", "tutorial", "guide", "instructions"
      ],
      "action": "showHelp"
    }
  },

  "parameter_extraction": {
    "numbers": {
      "patterns": ["\\d+", "\\d*\\.\\d+"],
      "context_clues": {
        "lanes": ["lane", "lanes"],
        "offset": ["offset", "shift", "move"],
        "intensity": ["intensity", "brightness", "contrast"],
        "size": ["kDa", "bp", "kb", "Da"]
      }
    },
    "ranges": {
      "patterns": ["\\d+-\\d+", "from \\d+ to \\d+", "between \\d+ and \\d+"]
    }
  },

  "context_awareness": {
    "gel_state": {
      "loaded": "image_loaded",
      "lanes_detected": "lanes_available", 
      "bands_detected": "bands_available",
      "calibrated": "calibration_available"
    },
    "suggested_next_steps": {
      "after_lane_detection": ["detect bands", "calibrate with ladder"],
      "after_band_detection": ["quantify bands", "export results"],
      "after_calibration": ["calculate molecular weights"],
      "after_quantification": ["normalize data", "export results"]
    }
  }
}