# AutoDense Environment Configuration
  # Configured for your specific AutoDense setup

  # =============================================================================
  # JAVA ENVIRONMENT
  # =============================================================================

  # Java installation directory (optional - will auto-discover if not set)
  JAVA_HOME=/usr/local/openjdk-17

  # Maximum heap size for Java processes (increased for large image processing)
  JAVA_MAX_HEAP=6g

  # Additional JVM options (optional)
  JAVA_OPTS=-Djava.awt.headless=true -Duser.timezone=UTC

  # =============================================================================
  # FIJI/IMAGEJ ENVIRONMENT  
  # =============================================================================

  # Fiji installation directory (configured for macOS)
  FIJI_DIR=/Applications/Fiji

  # Alternative: ImageJ installation directory
  IMAGEJ_DIR=

  # Override auto-discovered ImageJ executable path (optional)
  IMAGEJ_EXECUTABLE=

  # =============================================================================
  # AUTODENSE PROJECT CONFIGURATION
  # =============================================================================

  # AutoDense main class for Java execution (your CLI)
  AUTODENSE_MAIN_CLASS=com.betterdairy.autodense.cli.AutotuneAnalysisCLI

  # Project root directory (optional - auto-detected from script location)
  AUTODENSE_PROJECT_ROOT=

  # Maven POM directory (your Java module location)
  POM_DIR=autodense/plugin

  # =============================================================================
  # API CONFIGURATION
  # =============================================================================

  # Google Gemini API Key (required for AI orchestration)
  GEMINI_API_KEY=AIzaSy...

  # OpenAI API Key (optional - for multi-LLM analysis)
  OPENAI_API_KEY=sk-proj-...

  # Grok API Key (optional - for additional AI analysis)
  GROK_API_KEY=xai-...

  # =============================================================================
  # PYTHON ENVIRONMENT
  # =============================================================================

  # Python executable path (optional - defaults to 'python')
  PYTHON_EXECUTABLE=python3

  # Python virtual environment path (optional)
  PYTHON_VENV=.venv

  # Enable unbuffered output for better logging
  PYTHONUNBUFFERED=1

  # =============================================================================
  # OPTIMIZATION SYSTEM CONFIGURATION
  # =============================================================================

  # Default working directory for autotune runs
  AUTOTUNE_WORKDIR=audits/autotune_runs

  # Cache directory for expensive operations
  CACHE_DIR=~/.autodense/cache

  # Default timeout for analysis operations (seconds)
  ANALYSIS_TIMEOUT=300

  # Enable debug logging for troubleshooting
  DEBUG_LOGGING=false

  # =============================================================================
  # DEVELOPMENT ENVIRONMENT
  # =============================================================================

  # Enable development mode features
  DEV_MODE=false

  # Skip certain validation checks for faster iteration
  SKIP_VALIDATION=false

  # Custom log level (DEBUG, INFO, WARNING, ERROR)
  LOG_LEVEL=INFO

  # =============================================================================
  # PLATFORM-SPECIFIC SETTINGS
  # =============================================================================

  # macOS: Enable app bundle execution mode
  MACOS_APP_MODE=true

  # Windows: Use Windows-specific paths and executables
  WINDOWS_MODE=false

  # Linux: Enable X11 forwarding for GUI applications
  LINUX_X11_FORWARD=false

  # =============================================================================
  # PERFORMANCE TUNING
  # =============================================================================

  # Number of parallel processing threads
  MAX_THREADS=4

  # Image processing memory limits
  MAX_IMAGE_SIZE_MB=500

  # Enable GPU acceleration if available
  ENABLE_GPU=false

  # =============================================================================
  # SECURITY CONFIGURATION
  # =============================================================================

  # Disable network access during processing (security hardening)
  OFFLINE_MODE=false

  # Validate all input files before processing
  STRICT_INPUT_VALIDATION=true

  # Enable audit logging for all operations
  ENABLE_AUDIT_LOG=true