# Enhanced AutoDense Multi-Environment Coordination
# 
# This Makefile provides comprehensive environment management and optimization
# targets for the AutoDense multi-environment architecture (Python + Java + ImageJ + Maven)
#
# Usage examples:
#   make env-check                           # Validate environment setup
#   make discover-fiji                       # Find and cache Fiji installations
#   make tune-sds INPUT=path/to/gel.png      # Standard Python optimization
#   make tune-sds-ij INPUT=path/to/gel.png   # ImageJ-backed optimization
#   make build-java                          # Ensure Java components are built
#   make health-check                        # Complete system health check
# 
# Environment Variables:
#   WORKDIR     - Working directory for autotune runs (default: audits/autotune_runs)
#   INPUT       - Input image/file path (required for tune-* targets)
#   FIJI_DIR    - Fiji installation directory (auto-discovered if not set)
#   JAVA_HOME   - Java installation directory (auto-discovered if not set)
#   PY          - Python executable (default: python)

# Configuration
PY ?= python3
WORKDIR ?= audits/autotune_runs
SCRIPTS_DIR := scripts
AUTOTUNE_MODULE := autodense_autotune

# AutoDense-specific Java configuration
JAVA_MAIN ?= com.betterdairy.autodense.cli.AutotuneAnalysisCLI
POM_DIR_PATH ?= autodense/plugin

# =============================================================================
# ENVIRONMENT SETUP
# =============================================================================

setup-env:
	@echo "🔧 Setting up AutoDense environment..."
	@bash -c "source scripts/test_env.sh && env | grep -E '(FIJI_DIR|AUTODENSE|PYTHON)'"

# =============================================================================
# ENVIRONMENT VALIDATION AND DISCOVERY
# =============================================================================

env-check:
	@echo "🔍 Validating AutoDense environment..."
	$(PY) $(SCRIPTS_DIR)/env_check.py --json

env-check-verbose:
	@echo "🔍 Validating AutoDense environment (verbose)..."
	$(PY) $(SCRIPTS_DIR)/env_check.py --verbose

discover-fiji:
	@echo "🔍 Discovering Fiji/ImageJ installations..."
	$(PY) $(SCRIPTS_DIR)/discover_imagej.py --json

discover-fiji-verbose:
	@echo "🔍 Discovering Fiji/ImageJ installations (verbose)..."
	$(PY) $(SCRIPTS_DIR)/discover_imagej.py --verbose

health-check:
	@echo "🏥 Running comprehensive system health check..."
	@$(PY) -m $(AUTOTUNE_MODULE).java_bridge --env-check || echo "❌ Health check failed"
	@$(MAKE) env-check 2>/dev/null || echo "❌ Environment check failed"
	@$(MAKE) discover-fiji 2>/dev/null || echo "❌ Fiji discovery failed"
	@echo "✅ Health check completed"

# =============================================================================
# BUILD AND COMPILATION
# =============================================================================

build-java:
	@echo "🔨 Building Java components..."
	cd autodense/plugin && mvn compile dependency:build-classpath -Dmdep.outputFile=target/classpath.txt

build-java-clean:
	@echo "🧹 Clean building Java components..."
	cd autodense/plugin && mvn clean compile dependency:build-classpath -Dmdep.outputFile=target/classpath.txt

verify-build:
	@echo "🔍 Verifying build artifacts..."
	@test -d autodense/plugin/target/classes || (echo "❌ Classes directory not found" && exit 1)
	@test -f autodense/plugin/target/classpath.txt || (echo "❌ Classpath file not found" && exit 1)
	@echo "✅ Build verification passed"

# =============================================================================
# PYTHON-BASED OPTIMIZATION (Standard)
# =============================================================================

tune-sds:
	@test -n "$(INPUT)" || (echo "❌ INPUT variable required" && exit 1)
	@echo "🧬 Running SDS-PAGE optimization with Python backend..."
	$(PY) -m $(AUTOTUNE_MODULE).cli \
	  --spec challenge_packs/sds_page_v1/spec.yaml \
	  --input "$(INPUT)" \
	  --workdir "$(WORKDIR)" \
	  --run-cmd "python -m $(AUTOTUNE_MODULE).runners sds_page --input {input} --outdir {outdir}" \
	  --print-summary

tune-colony:
	@test -n "$(INPUT)" || (echo "❌ INPUT variable required" && exit 1)
	@echo "🦠 Running colony counting optimization with Python backend..."
	$(PY) -m $(AUTOTUNE_MODULE).cli \
	  --spec challenge_packs/colony_count_v1/spec.yaml \
	  --input "$(INPUT)" \
	  --workdir "$(WORKDIR)" \
	  --run-cmd "python -m $(AUTOTUNE_MODULE).runners colony_count --input {input} --outdir {outdir}" \
	  --print-summary

tune-etbr:
	@test -n "$(INPUT)" || (echo "❌ INPUT variable required" && exit 1)
	@echo "🧬 Running EtBr agarose optimization with Python backend..."
	$(PY) -m $(AUTOTUNE_MODULE).cli \
	  --spec challenge_packs/etbr_v1/spec.yaml \
	  --input "$(INPUT)" \
	  --workdir "$(WORKDIR)" \
	  --run-cmd "python -m $(AUTOTUNE_MODULE).runners etbr_agarose --input {input} --outdir {outdir}" \
	  --print-summary

# =============================================================================
# IMAGEJ-BACKED OPTIMIZATION (Enhanced)
# =============================================================================

tune-sds-ij:
	@test -n "$(INPUT)" || (echo "❌ INPUT variable required" && exit 1)
	@$(MAKE) verify-build
	@echo "🧬 Running SDS-PAGE optimization with ImageJ backend..."
	@bash -c "source scripts/test_env.sh && python -m $(AUTOTUNE_MODULE).java_bridge --task sds_page --input \"$(INPUT)\" --outdir /tmp/sds_test --config configs/sds.yaml"

tune-colony-ij:
	@test -n "$(INPUT)" || (echo "❌ INPUT variable required" && exit 1)
	@$(MAKE) verify-build
	@echo "🦠 Running colony counting optimization with ImageJ backend..."
	$(PY) -m $(AUTOTUNE_MODULE).cli \
	  --spec challenge_packs/colony_count_v1/spec.yaml \
	  --input "$(INPUT)" \
	  --workdir "$(WORKDIR)" \
	  --run-cmd "python -m $(AUTOTUNE_MODULE).java_bridge --task colony_count --input {input} --outdir {outdir} --config configs/colony.yaml --java-main $(JAVA_MAIN) --pom-dir $(POM_DIR_PATH)" \
	  --print-summary

tune-etbr-ij:
	@test -n "$(INPUT)" || (echo "❌ INPUT variable required" && exit 1)
	@$(MAKE) verify-build
	@echo "🧬 Running EtBr agarose optimization with ImageJ backend..."
	$(PY) -m $(AUTOTUNE_MODULE).cli \
	  --spec challenge_packs/etbr_v1/spec.yaml \
	  --input "$(INPUT)" \
	  --workdir "$(WORKDIR)" \
	  --run-cmd "python -m $(AUTOTUNE_MODULE).java_bridge --task etbr_agarose --input {input} --outdir {outdir} --config configs/etbr.yaml --java-main $(JAVA_MAIN) --pom-dir $(POM_DIR_PATH)" \
	  --print-summary

# =============================================================================
# DEBUGGING AND DIAGNOSTICS
# =============================================================================

test-java-bridge:
	@echo "🧪 Testing Java bridge functionality..."
	$(PY) -m $(AUTOTUNE_MODULE).java_bridge --env-check

test-classpath:
	@echo "🔍 Testing classpath construction..."
	$(PY) -c "from $(AUTOTUNE_MODULE).java_bridge import build_classpath; import os; print('Classpath components:', len(build_classpath().split(':' if os.name != 'nt' else ';')))"

debug-env:
	@echo "🐛 Debug environment information..."
	@echo "Python: $(shell $(PY) --version)"
	@echo "Java: $(shell java -version 2>&1 | head -1 || echo 'Not found')"
	@echo "Maven: $(shell mvn --version 2>&1 | head -1 || echo 'Not found')"
	@echo "JAVA_HOME: $(JAVA_HOME)"
	@echo "FIJI_DIR: $(FIJI_DIR)"
	@echo "Working directory: $(WORKDIR)"

clean-cache:
	@echo "🧹 Clearing optimization and discovery caches..."
	rm -rf ~/.autodense/cache
	rm -rf $(WORKDIR)/*/
	@echo "✅ Cache cleared"

# =============================================================================
# CONVENIENCE TARGETS
# =============================================================================

# Quick setup for new environments
setup:
	@echo "🚀 Setting up AutoDense environment..."
	@$(MAKE) env-check || echo "⚠️  Environment issues detected"
	@$(MAKE) build-java || echo "⚠️  Java build issues detected"
	@$(MAKE) discover-fiji || echo "⚠️  Fiji discovery issues detected"
	@echo "✅ Setup completed"

# Show help
help:
	@echo "AutoDense Multi-Environment Coordination"
	@echo ""
	@echo "Environment Management:"
	@echo "  env-check          Validate Python, Java, Maven, Fiji environment"
	@echo "  discover-fiji      Find and cache Fiji/ImageJ installations"
	@echo "  health-check       Complete system health verification"
	@echo "  setup              Initial environment setup and validation"
	@echo ""
	@echo "Build Targets:"
	@echo "  build-java         Compile Java components and generate classpath"
	@echo "  build-java-clean   Clean compile Java components"
	@echo "  verify-build       Verify build artifacts exist"
	@echo ""
	@echo "Python-Based Optimization:"
	@echo "  tune-sds           SDS-PAGE analysis optimization"
	@echo "  tune-colony        Colony counting optimization"
	@echo "  tune-etbr          EtBr agarose gel optimization"
	@echo ""
	@echo "ImageJ-Backed Optimization:"
	@echo "  tune-sds-ij        SDS-PAGE with full ImageJ integration"
	@echo "  tune-colony-ij     Colony counting with ImageJ backend"
	@echo "  tune-etbr-ij       EtBr analysis with ImageJ backend"
	@echo ""
	@echo "Debugging:"
	@echo "  test-java-bridge   Test Java bridge functionality"
	@echo "  debug-env          Show environment debug information"
	@echo "  clean-cache        Clear all caches"
	@echo ""
	@echo "Required Variables:"
	@echo "  INPUT              Path to input image (required for tune-* targets)"
	@echo ""
	@echo "Optional Variables:"
	@echo "  WORKDIR            Working directory (default: audits/autotune_runs)"
	@echo "  FIJI_DIR           Fiji installation path (auto-discovered)"
	@echo "  JAVA_HOME          Java installation path (auto-discovered)"

.DEFAULT_GOAL := help

.PHONY: env-check env-check-verbose discover-fiji discover-fiji-verbose health-check \
        build-java build-java-clean verify-build \
        tune-sds tune-colony tune-etbr \
        tune-sds-ij tune-colony-ij tune-etbr-ij \
        test-java-bridge test-classpath debug-env clean-cache \
        setup help