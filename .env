# AutoDense Python Environment Configuration
# Pure Python scientific analysis environment

# PYTHON ENVIRONMENT
PYTHONPATH=scripts:$PYTHONPATH

# SCIENTIFIC LIBRARIES
# Core stack: numpy, scipy, scikit-image, matplotlib, pillow

# STREAMLIT UI CONFIGURATION
STREAMLIT_PORT=8501
STREAMLIT_HOST=localhost

# OUTPUT DIRECTORIES
OUTPUT_DIR=output
RESULTS_DIR=results
TEMP_DIR=temp

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=autodense.log

# ANALYSIS SETTINGS
DEFAULT_DPI=300
MAX_IMAGE_SIZE_MB=100

# DEVELOPMENT
DEBUG=false

